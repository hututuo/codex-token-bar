{
  "protocol": "agent-speed-report",
  "versions": [
    1
  ],
  "service": {
    "name": "速蹬雷达",
    "description": "社区贡献的实时速蹬天梯、全站吞吐与模型实测均速。",
    "homepage": "https://deng.codexradar.com/",
    "terms": "https://deng.codexradar.com/agent-speed/terms/",
    "privacy": "https://deng.codexradar.com/agent-speed/privacy/",
    "leaderboard": "https://deng.codexradar.com/",
    "retentionDays": 0
  },
  "api": "https://speed-api.codexradar.com/api/agent-speed",
  "apiKey": {
    "mode": "none"
  },
  "username": {
    "minLength": 2,
    "maxLength": 32,
    "charset": "unicode",
    "spaces": true
  },
  "limits": {
    "intervalSeconds": 5,
    "heartbeatSeconds": 60,
    "maxAgeSeconds": 30,
    "maxBodyBytes": 16384,
    "maxModels": 16
  },
  "sections": [
    "sources",
    "models",
    "cost",
    "traffic",
    "machineTraffic"
  ],
  "extensions": {
    "modelHarnessRequests": 1,
    "executionModes": 1,
    "profileAvatar": 1,
    "sharedIdentity": 1,
    "reportWebSocket": 1
  },
  "websocket": {
    "path": "/v1/reports/ws",
    "subprotocol": "agent-speed-report.v1",
    "minIntervalMs": 50,
    "maxInFlight": 8,
    "ackTimeoutMs": 2000,
    "maxMessageBytes": 65536,
    "pingIntervalSeconds": 20,
    "pongTimeoutSeconds": 10
  }
}
