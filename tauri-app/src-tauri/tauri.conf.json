{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Token Bar",
  "version": "0.1.0",
  "identifier": "local.codex.token-bar.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Token Bar",
        "width": 1180,
        "height": 860,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
