{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Token Bar",
  "version": "0.7.3",
  "identifier": "local.codex.token-bar.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://codexradar.com/current.json https://codexradar.com/feed.xml https://api.codexradar.com/api/v1/table https://api.codexradar.com/api/v1/leaderboard; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "OpenSourceLicenses/AGPL-3.0.txt",
      "../../LICENSES/CodexTokenBar-MIT.txt": "OpenSourceLicenses/CodexTokenBar-MIT.txt",
      "../../OPEN_SOURCE_NOTICES.md": "OPEN_SOURCE_NOTICES.md"
    },
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMUI3M0M0MjhDNjY5OUEKUldTYWFjWW94SE1iUHJ5dG53aWJOdUFyaU9JdWlTTDliRm1HR3dSZHI4WG04MlNlemdmTDB5Q0YK",
      "endpoints": [
        "https://github.com/hututuo/codex-token-bar/releases/latest/download/latest-windows.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
