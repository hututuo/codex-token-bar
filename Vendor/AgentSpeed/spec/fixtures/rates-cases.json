        }
      },
      "expect": {
        "dateMs": 1792627200000,
        "rates": {
          "CNY": "6.67476008",
          "EUR": "0.88943738",
          "JPY": "157.7279153",
          "TWD": "32.5520031",
          "USD": "1"
        }
      }
    },
    {
      "name": "Frankfurter (ECB; no TWD)",
