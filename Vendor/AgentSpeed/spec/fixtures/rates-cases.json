{
  "_comment": "NETWORK 4. `parse`: provider body -> date (Unix ms) and the rates of `supported` currencies as decimal strings, USD = 1 (null = rejected). `accept`: checks 3-5 for the selected currency; `last` = the stored rates with their date and the time they were accepted, `fallback` = bundled rates, `other` = a second provider's rates.",
  "supported": [
    "USD",
    "CNY",
    "TWD",
    "JPY",
    "EUR"
  ],
  "parse": [
    {
      "name": "ExchangeRate-API open access",
      "provider": "open.er-api.com",
      "body": {
        "result": "success",
        "provider": "https://www.exchangerate-api.com",
        "time_last_update_unix": 1792627351,
        "base_code": "USD",
        "rates": {
          "USD": 1,
          "CNY": 6.689327,
          "TWD": 32.411205,
          "JPY": 158.100039,
          "EUR": 0.890292,
          "XAU": 0.000301
        }
      },
      "expect": {
        "dateMs": 1792627351000,
        "rates": {
          "CNY": "6.689327",
          "EUR": "0.890292",
          "JPY": "158.100039",
          "TWD": "32.411205",
          "USD": "1"
        }
      }
    },
    {
      "name": "an error response is rejected",
      "provider": "open.er-api.com",
      "body": {
        "result": "error",
        "error-type": "unsupported-code"
      },
      "expect": null
    },
    {
      "name": "fawazahmed0 currency-api (lower-case codes, extra assets ignored)",
