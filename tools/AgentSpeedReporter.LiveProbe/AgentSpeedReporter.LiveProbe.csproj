<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AgentSpeedReporter.LiveProbe</AssemblyName>
    <RootNamespace>CodexTokenBar.AgentSpeedReporter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Vendor/AgentSpeed/windows/src/AgentSpeed.Core/AgentSpeed.Core.csproj" />
    <Compile Include="../AgentSpeedReporter/DpapiReportKeyStore.cs" Link="Production/DpapiReportKeyStore.cs" />
    <Compile Include="../AgentSpeedReporter/RealtimeReportBody.cs" Link="Production/RealtimeReportBody.cs" />
    <Compile Include="../AgentSpeedReporter/AgentSpeedReportSourcePolicy.cs" Link="Production/AgentSpeedReportSourcePolicy.cs" />
    <Compile Include="../AgentSpeedReporter/ReportPayloadWhitelist.cs" Link="Production/ReportPayloadWhitelist.cs" />
    <Compile Include="../AgentSpeedReporter/ReportWebSocketSession.cs" Link="Production/ReportWebSocketSession.cs" />
    <Compile Include="../AgentSpeedReporter/WebSocketRuntimePrimitives.cs" Link="Production/WebSocketRuntimePrimitives.cs" />
  </ItemGroup>
</Project>
