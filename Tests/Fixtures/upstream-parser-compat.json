[
  {
    "name": "paginated prefix never contributes usage or copied stop facts",
    "family": "codex",
    "lines": [
      "{\"type\":\"session_meta\",\"payload\":{\"id\":\"child\",\"thread_source\":\"subagent\",\"subagent_history_start_ordinal\":5},\"timestamp\":\"2026-10-20T10:00:00Z\",\"ordinal\":0}",
      "{\"type\":\"turn_context\",\"payload\":{\"model\":\"copied-model\"},\"timestamp\":\"2026-10-20T10:00:00Z\",\"ordinal\":1}",
      "{\"type\":\"token_usage_record\",\"payload\":{\"response_id\":\"copied\",\"usage\":{\"input_tokens\":10,\"output_tokens\":900}},\"timestamp\":\"2026-10-20T10:00:02Z\",\"ordinal\":2}",
      "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\"},\"ordinal\":3}",
      "{\"type\":\"turn_context\",\"payload\":{\"model\":\"child-model\"},\"timestamp\":\"2026-10-20T10:00:00Z\",\"ordinal\":5}",
      "{\"type\":\"token_usage_record\",\"payload\":{\"response_id\":\"own\",\"usage\":{\"input_tokens\":10,\"output_tokens\":7}},\"timestamp\":\"2026-10-20T10:00:02Z\",\"ordinal\":6}"
    ],
    "expected": {
      "output": 7,
      "responseCount": 1,
      "phase": "tools",
      "model": "child-model",
      "stopped": false
    }
  },
